# -----------------------

# Study-area build profiles and scenario overlays are generally local,
# system-boundary and policy-specific configuration. Keep the committed sample
# templates and canonical baseline scenario available in a clean checkout.

# -----------------------

config/build_profiles/*.toml
!config/build_profiles/sample_build_profile.toml

registry/scenarios/*.toml
!registry/scenarios/baseline.toml
!registry/scenarios/sample_scenario.toml


